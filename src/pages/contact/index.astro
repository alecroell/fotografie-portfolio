---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Contact | ALECROELLFOTOGRAFIE">
  <section class="page page--narrow" aria-labelledby="contact-title">
    <header class="intro">
      <h1 id="contact-title">Contact</h1>
      <p>
        Neem gerust contact op om je wensen te bespreken of een voorstel aan te vragen.
      </p>
    </header>

    <section class="contactContent">
      <form
        class="form"
        action="https://formsubmit.co/alecroell@hotmail.com"
        method="POST"
        aria-label="Contactformulier"
      >
        <input type="text" name="_honey" style="display:none" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="https://alecroellfotografie.nl/" />

        <div class="row">
          <label class="field">
            <span class="label">Naam</span>
            <input class="control" name="Naam" type="text" required />
          </label>

          <label class="field">
            <span class="label">E-mail</span>
            <input class="control" name="E-mail" type="email" required />
          </label>
        </div>

        <label class="field">
          <span class="label">Onderwerp</span>
          <input class="control" name="Onderwerp" type="text" required />
        </label>

        <label class="field">
          <span class="label">Bericht</span>
          <textarea class="control" name="Bericht" rows="7" required></textarea>
        </label>

        <div class="submitWrap">
          <button class="cta submit" type="submit">Versturen</button>
        </div>
      </form>
    </section>
  </section>

  <style>
    .contactContent {
      border-top: 1px solid rgba(107, 61, 46, 0.25);
      padding-top: 2.5rem;
    }

    .form {
      display: grid;
      gap: 1.2rem;
      text-align: left;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .field {
      display: grid;
      gap: 0.4rem;
    }

    .label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 1.6px;
      color: var(--accent);
      font-family: ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino,
        Garamond, Georgia, serif;
    }

    .control {
      border: 1px solid rgba(107, 61, 46, 0.25);
      background: rgba(107, 61, 46, 0.03);
      padding: 0.9rem 1rem;
      font-size: 0.95rem;
      font-family: inherit;
      border-radius: 0;
      outline: none;
      width: 100%;
      box-sizing: border-box;
      resize: vertical;
    }

    .control:focus {
      border-color: rgba(107, 61, 46, 0.45);
      background: rgba(107, 61, 46, 0.02);
    }

    .submitWrap {
      display: flex;
      justify-content: center;
      margin-top: 0.5rem;
    }

    .submit {
      cursor: pointer;
    }

    @media (max-width: 640px) {
      .row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>