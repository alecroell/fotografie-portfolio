---
import Layout from "../../../../layouts/Layout.astro";
import LightboxGallery from "../../../../components/LightboxGallery.astro";
---

<Layout title="Sam, Scott & Lebon — Portret & Evenement">
  <section class="page">
    <header class="intro">
      <h1>Sam, Scott & Lebon</h1>
      <p>Klik op een foto om te vergroten.</p>
    </header>

    <LightboxGallery
      images={[
        { src: "/fotos/portfolio/portret-evenement/sam-scott-lebon/Roma_20.jpg", alt: "Sam Scott-Lebon" },
        { src: "/fotos/portfolio/portret-evenement/sam-scott-lebon/Roma_22.jpg", alt: "Sam Scott-Lebon" },
        { src: "/fotos/portfolio/portret-evenement/sam-scott-lebon/Roma_25.jpg", alt: "Sam Scott-Lebon" }
      ]}
      columns={3}
      fit="cover"
      overlayBg="rgba(0,0,0,0.6)"
    />
  </section>
</Layout>