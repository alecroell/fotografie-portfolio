---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Portfolio | ALECROELLFOTOGRAFIE">
  <section class="page">
    <header class="intro">
      <h1>Portfolio</h1>
      <p>Kies een categorie om albums te bekijken.</p>
    </header>

    <section class="categories">
        <article class="card">
        <a href="/portfolio/product-interieur">
          <img
            src="/fotos/portfolio/product-interieur/mos/foto cafe mos.jpg"
            alt="Product & Interieur"
          />
          <h2>Product & Interieur</h2>
          <span class="cta">Bekijk albums</span>
        </a>
      </article>

      <article class="card">
        <a href="/portfolio/portret-evenement">
          <img
            src="/fotos/portfolio/portret-evenement/momo-maay-jochem/maya.jpg"
            alt="Portret & Evenement"
          />
          <h2>Portret & Evenement</h2>
          <span class="cta">Bekijk albums</span>
        </a>
      </article>

        <article class="card">
        <a href="/portfolio/reizen-plekken">
          <img
            src="/fotos/portfolio/reizen-plekken/parijs/vogel.jpg"
            alt="Reizen & Plekken"
          />
          <h2>Reizen & Plekken</h2>
          <span class="cta">Bekijk albums</span>
        </a>
      </article>
    </section>
  </section>

  <style>
    .categories {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
      align-items: start;
    }

    .card {
      text-align: center;
    }

    .card a {
      text-decoration: none;
      color: inherit;
      display: block;
    }

    .card img {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      display: block;
      border: 1px solid rgba(0, 0, 0, 0.15);
      transition: transform 0.3s ease;
      background: #fafafa;
    }

    .card img:hover {
      transform: scale(1.02);
    }

    .card h2 {
      margin: 1.2rem 0 1rem;
      color: var(--accent);
      font-family: ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino,
        Garamond, Georgia, serif;
      font-weight: 600;
      font-size: 1.2rem;
    }

    @media (max-width: 900px) {
      .categories {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>