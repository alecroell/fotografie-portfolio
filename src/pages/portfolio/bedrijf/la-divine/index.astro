---
import Layout from "../../../../layouts/Layout.astro";
import LightboxGallery from "../../../../components/LightboxGallery.astro";
---

<Layout title="La Divine — Bedrijf">
  <section class="page">
    <header class="intro">
      <h1>La Divine</h1>
      <p>Klik op een foto om te vergroten.</p>
    </header>

    <LightboxGallery
      images={[
        { src: "/fotos/portfolio/bedrijf/la-divine/cakeje%20maken.jpg", alt: "La Divine" },
        { src: "/fotos/portfolio/bedrijf/la-divine/snoef_3.jpg", alt: "La Divine" },
        { src: "/fotos/portfolio/bedrijf/la-divine/cake2.jpg", alt: "La Divine" }
      ]}
      columns={3}
      fit="cover"
      overlayBg="rgba(0,0,0,0.6)"
    />
  </section>
</Layout>