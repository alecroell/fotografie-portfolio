---
import Layout from "../../../../layouts/Layout.astro";
import LightboxGallery from "../../../../components/LightboxGallery.astro";
---

<Layout title="Natulatte — Bedrijf">
  <section class="page">
    <header class="intro">
      <h1>Natulatte</h1>
      <p>Klik op een foto om te vergroten.</p>
    </header>

    <LightboxGallery
      images={[
        { src: "/fotos/portfolio/bedrijf/natulatte/natulatte_7.jpg", alt: "Natulatte" },
        { src: "/fotos/portfolio/bedrijf/natulatte/natulatte_1.jpg", alt: "Natulatte" },
        { src: "/fotos/portfolio/bedrijf/natulatte/natulatte_6.jpg", alt: "Natulatte" }
        
      ]}
      columns={3}
      fit="cover"
      overlayBg="rgba(0,0,0,0.6)"
    />
  </section>
</Layout>