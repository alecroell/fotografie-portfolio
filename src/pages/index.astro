---
import Layout from "../layouts/Layout.astro";
---

<Layout title="ALECROELLFOTOGRAFIE">
  <section class="page">
    <header class="intro" aria-labelledby="home-title">
      <h1 id="home-title">Welkom!</h1>
      <p>
        Neem een kijkje in mijn portfolio of neem contact met me op.
      </p>
    </header>

    <section class="tiles" aria-label="Snelle navigatie">
      <article class="tile">
        <a class="tileLink" href="/portfolio" aria-label="Bekijk portfolio">
          <figure class="frame">
            <img
              src="/fotos/cameraa_2.jpg"
              alt="Portfolio sfeerbeeld"
              loading="eager"
              decoding="async"
            />
          </figure>
          <span class="cta">Bekijk portfolio</span>
        </a>
      </article>

      <article class="tile">
        <a class="tileLink" href="/contact" aria-label="Ga naar contact">
          <figure class="frame">
            <img
              src="/fotos/foto cafe mos.jpg"
              alt="Contact sfeerbeeld"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <span class="cta">Contact</span>
        </a>
      </article>
    </section>
  </section>

  <style>
    .tiles {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3.25rem;
      align-items: start;
      justify-items: center;
    }

    .tile {
      width: 100%;
      display: grid;
      justify-items: center;
    }

    .tileLink {
      width: 100%;
      max-width: 440px;
      text-decoration: none;
      color: inherit;
      display: grid;
      gap: 1.25rem;
      justify-items: center;
    }

    .frame {
      width: 100%;
      margin: 0;
      border: 1px solid var(--line);
      background: #fafafa;
      overflow: hidden;
    }

    .frame img {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      display: block;
      border-radius: 0;
      transform: scale(1);
      transition: transform 220ms ease;
    }

    .tileLink:hover .frame img {
      transform: scale(1.02);
    }

    @media (max-width: 920px) {
      .tiles {
        grid-template-columns: 1fr;
        gap: 2.25rem;
      }

      .tileLink {
        max-width: 520px;
      }
    }
  </style>
</Layout>