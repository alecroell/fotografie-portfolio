---
const { title = "ALECROELLFOTOGRAFIE" } = Astro.props;
const path = Astro.url.pathname;

const isActive = (href: string): boolean => {
  if (href === "/") return path === "/";
  return path.toLowerCase().startsWith(href.toLowerCase());
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#6b3d2e" />
  </head>

  <body>
    <div class="wrap">
      <header class="siteHeader">
        <a class="brand" href="/">ALECROELLFOTOGRAFIE</a>

        <nav class="nav" aria-label="Hoofdnavigatie">
          <a class={isActive("/portfolio") ? "active" : ""} href="/portfolio">
            PORTFOLIO
          </a>

          <a class={isActive("/reviews") ? "active" : ""} href="/reviews">
            REVIEWS
          </a>

          <a class={isActive("/contact") ? "active" : ""} href="/contact">
            CONTACT
          </a>

          <a class={isActive("/") ? "active" : ""} href="/">
            HOME
          </a>
        </nav>
      </header>

      <main class="content">
        <slot />
      </main>

      <footer class="siteFooter">
        <p class="footerText">© 2026 ALECROELLFOTOGRAFIE</p>

        <div class="footerLinks">
          <a
            href="mailto:alecroell@hotmail.com?subject=Fotografie aanvraag"
            aria-label="Mail"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 6h16v12H4z" />
              <path d="M4 7l8 6 8-6" />
            </svg>
            <span>MAIL</span>
          </a>

          <a
            href="https://www.instagram.com/alecroellfotografie/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1.2" />
            </svg>
            <span>INSTAGRAM</span>
          </a>

          <a
            href="https://nl.linkedin.com/in/alec-r%C3%B6ell/en"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 9H3v12h3V9z" />
              <circle cx="4.5" cy="5" r="1.5" />
              <path d="M9 9h3v2c.5-1 2-2 4-2 3 0 5 2 5 6v6h-3v-5c0-2-1-3-2.5-3S13 14 13 16v5H9z" />
            </svg>
            <span>LINKEDIN</span>
          </a>
        </div>
      </footer>
    </div>

    <style>
      :global(:root) {
        --accent: #6b3d2e;
        --ink: #111;
        --muted: #4b4b4b;
        --line: rgba(0, 0, 0, 0.14);
        --paper: #fff;
        --max: 1180px;
      }

      :global(html, body) {
        margin: 0;
        min-height: 100%;
      }

      :global(body) {
        background: #fff;
        color: var(--ink);
        min-height: 100vh;
      }

      .wrap {
        max-width: var(--max);
        margin: 0 auto;
        padding: 3rem 2.5rem;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
      }

      .siteHeader {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 2rem;
      }

      .brand {
        font-family: ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino,
          Garamond, Georgia, serif;
        font-weight: 600;
        letter-spacing: 3.4px;
        text-transform: uppercase;
        font-size: 1.3rem;
        color: var(--accent);
        text-decoration: none;
      }

      .nav {
        display: flex;
        gap: 3.5rem;
      }

      .nav a {
        font-family: ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino,
          Garamond, Georgia, serif;
        text-transform: uppercase;
        letter-spacing: 3.2px;
        font-size: 0.95rem;
        color: var(--accent);
        text-decoration: none;
        padding-bottom: 0.3rem;
        border-bottom: 1px solid transparent;
      }

      .nav a:hover {
        border-bottom-color: rgba(107, 61, 46, 0.35);
      }

      .nav a.active {
        border-bottom-color: rgba(107, 61, 46, 0.6);
      }

      .content {
        flex: 1;
        padding-top: 6rem;
      }

      :global(.page) {
        max-width: 1100px;
        margin: 0 auto;
        padding: 3.5rem 1.5rem 5rem;
        color: var(--ink);
        background: var(--paper);
        box-sizing: border-box;
      }

      :global(.page--narrow) {
        max-width: 720px;
      }

      :global(.intro) {
        text-align: center;
        margin-bottom: 2.75rem;
      }

      :global(.intro h1) {
        font-family: ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino,
          Garamond, Georgia, serif;
        font-weight: 600;
        letter-spacing: 0.2px;
        font-size: clamp(2.05rem, 3vw, 3rem);
        line-height: 1.15;
        margin: 0 0 0.75rem;
        color: var(--accent);
      }

      :global(.intro p) {
        max-width: 62ch;
        margin: 0 auto;
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto,
          Arial, "Noto Sans", "Liberation Sans", sans-serif;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--muted);
      }

      :global(.cta) {
        display: inline-block;
        padding: 0.85rem 1.6rem;
        border: 1px solid var(--line);
        background: transparent;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 600;
        font-size: 0.82rem;
        font-family: ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino,
          Garamond, Georgia, serif;
        color: var(--accent);
        transition: background 180ms ease, border-color 180ms ease;
        text-decoration: none;
      }

      :global(.cta:hover) {
        background: rgba(107, 61, 46, 0.04);
        border-color: rgba(107, 61, 46, 0.35);
      }

      .siteFooter {
        margin-top: 3rem;
        text-align: center;
      }

      .footerText {
        font-family: ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino,
          Garamond, Georgia, serif;
        font-size: 0.9rem;
        color: #6a6a6a;
        margin: 0;
        letter-spacing: 1px;
      }

      .footerLinks {
        margin-top: 0.8rem;
        display: flex;
        justify-content: center;
        gap: 1.6rem;
        align-items: center;
        flex-wrap: wrap;
      }

      .footerLinks a {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-family: ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino,
          Garamond, Georgia, serif;
        font-size: 0.85rem;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: var(--accent);
        text-decoration: none;
      }

      .footerLinks svg {
        width: 15px;
        height: 15px;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.6;
        flex: 0 0 auto;
      }

      .footerLinks a:hover {
        opacity: 0.8;
      }

      @media (max-width: 860px) {
        .wrap {
          padding: 2rem 1.5rem;
        }

        .content {
          padding-top: 3rem;
        }

        .nav {
          gap: 2rem;
        }

        :global(.page) {
          padding: 2.5rem 0 4rem;
        }
      }

      @media (max-width: 640px) {
        .siteHeader {
          flex-direction: column;
          align-items: flex-start;
          gap: 1rem;
        }

        .nav {
          gap: 1.5rem;
          flex-wrap: wrap;
        }
      }
    </style>
  </body>
</html>